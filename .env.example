# Obligatorio en producción: clave aleatoria de al menos 32 caracteres
SESSION_SECRET=change-me-to-a-long-random-string

# Opcional: correo de verificación al registrarse (sin SMTP se muestra el código en consola del servidor)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=locker@tudominio.com
